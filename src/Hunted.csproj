<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Hunted</AssemblyName>
    <RootNamespace>Hunted</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The game and BepInEx assemblies aren't redistributable: never copy them next to our output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The headless arena (tools/Hunted.Arena) is built from Core too, but the game never runs it. -->
  <ItemGroup>
    <Compile Remove="Core\Arena\**" />
  </ItemGroup>

  <!-- BepInEx + MonoMod HookGen output (the On.X.Y hook API), from the game's own folders -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(RainWorldBepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HOOKS-Assembly-CSharp">
      <HintPath>$(RainWorldPath)\BepInEx\plugins\HOOKS-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MonoMod.RuntimeDetour for detouring property getters HookGen has no event for -->
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(RainWorldBepInExCorePath)\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(RainWorldBepInExCorePath)\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Mono.Cecil for the IL hook that lets the slugcat body keep both hands -->
    <Reference Include="Mono.Cecil">
      <HintPath>$(RainWorldBepInExCorePath)\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game + Unity assemblies, from RainWorld_Data/Managed -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RainWorldManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RainWorldManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RainWorldManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Some room/tile helpers expose Unity.Mathematics types -->
    <Reference Include="Unity.Mathematics">
      <HintPath>$(RainWorldManagedPath)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.Input for the testing hotkeys -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RainWorldManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Drop the built DLL straight into the deployable mod folder's plugins/ -->
  <Target Name="CopyToModFolder" AfterTargets="Build">
    <ItemGroup>
      <ModOutputFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <ModOutputFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModOutputFiles)" DestinationFolder="$(MSBuildThisFileDirectory)..\mod\plugins\" />
  </Target>

</Project>
